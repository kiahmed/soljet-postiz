# === Facades · Reflex — product tier config ===
# File-per-product layout: products/facades/<name>_tier.config, registered in
# src/lib/config_loader.py::_TIER_FILE_BY_ID. Shell-style key="value", same
# parser as arboryx.ai/tier.config. tier.dir is products/facades/.
#
# Reflex (facades-news-reactor) ships a FINISHED post — image, caption and
# hashtags — to public.best_signal_posts in its own Supabase project, then
# announces it on Pub/Sub. This tier only PUBLISHES it: no composer, no snap,
# no rewording. See docs/reflex_integration.md and news-reactor's
# docs/reflex_events_updates.md (§0 quick start, §4 Pub/Sub contract).

TIER_ID="reflex"
TIER_NAME="Reflex"
TIER_PARENT=""                              # standalone product, not a branch
CONTEXT_FILE="reflex_context.md"

# === Live data source ============================================
# The post row lives in news-reactor's Supabase (NOT EdgeLane's). RLS is on, so
# this is the owner/pooler connection string — Secret Manager `reflex-db-url`
# in Cloud Run, REFLEX_SUPABASE_DB_URL in .env locally. Never the anon key.
DATA_SOURCE_1_TYPE="reflex_posts"
DATA_SOURCE_1_DB_URL_ENV="REFLEX_SUPABASE_DB_URL"
DATA_SOURCE_1_TABLE="public.best_signal_posts"

# Pub/Sub wiring for bin/reflex_poster.py. The topic is Reflex's own and
# already exists (Reflex publishes, we only subscribe — it creates no subs).
REFLEX_PUBSUB_PROJECT="${GCP_PROJECT}"
REFLEX_PUBSUB_TOPIC="${REFLEX_POSTS_TOPIC}"                  # facades.reflex-signal-posts
REFLEX_PUBSUB_SUBSCRIPTION="${REFLEX_PUBSUB_SUBSCRIPTION}"   # facades.reflex-signal-posts.postiz
POST_ON_EVENTS="post_created"               # the only event Reflex emits today

# Stale-message guard: a market-move post is news for minutes, not days. A
# message whose created_at is older than this is acked and skipped (the row
# stays posted=false — `make reflex-event` can still push it by hand).
# Blank/0 disables.
REFLEX_MAX_AGE_MINUTES="180"

# Daily cap — OFF until the owner decides (Reflex expects "a few a week").
# When set, at most N posts per ET calendar day; extras are acked and skipped.
REFLEX_MAX_POSTS_PER_DAY=""

# No market-hours gate here: Reflex only emits during 04:00-16:00 ET on
# trading days, and pre-market moves are exactly what it posts.
MARKET_HOURS_ENFORCED="false"

# === Channels (Postiz integration IDs) ==========================
# Not connected yet — the tier stays DISABLED (no live channels) until these
# are set in .env; deploy.sh refuses to provision the subscription until then.
#   LinkedIn "Reflex" page (also gated by LINKEDIN_ENABLED).
CHANNEL_LINKEDIN="${POSTIZ_INTEGRATION_ID_LINKEDIN_REFLEX}"
#   X @facades_reflex (or whatever handle is chosen).
CHANNEL_X_PRIMARY="${POSTIZ_INTEGRATION_ID_X_REFLEX}"

# === Postiz routing ============================================
POSTIZ_CUSTOMER_ID="${POSTIZ_CUSTOMER_ID_REFLEX}"    # same "Facades" customer as Simmer/Matrix

# === Text per channel ==========================================
# X gets `caption` as-is (Reflex already fitted it to 280 by X's counting). Other
# channels get `caption_text` + a hashtag paragraph. Optional per-channel tag
# caps: trimmed from the END; the two brand tags (#Reflex #FacadesReflex) are
# never dropped. Blank = keep every tag Reflex chose.
REFLEX_MAX_HASHTAGS_X=""
REFLEX_MAX_HASHTAGS_LINKEDIN=""

# === Imagery ==================================================
# image_png (2400x1260) is posted as-is on every channel, with alt text built
# from headline/direction/move_bps/minutes_to_peak.
IMAGERY_POLICY_X="attach"
IMAGERY_POLICY_LINKEDIN="attach"

# === Tagging ==================================================
# OFF: the caption already carries "$SPY" and its hashtags; an appended entity
# cashtag would be a second one, which X rejects.
HANDLE_INJECTION="false"
CASHTAGS_ENABLED="false"
ENTITY_TAG_MODE="cashtag_only"
MAX_ENTITY_TAGS="0"

# === Cadence hints ===========================================
POSTING_CADENCE_DAILY="false"               # event-driven, not a daily drain
POSTING_TIMEZONE="America/New_York"

# === Posting purpose ========================================
POSTING_PURPOSE="Reflex watches market headlines, calls SPY's direction with an LLM within seconds, and waits for price to confirm. When a confirmed call is followed by a real move (>=10 bps within 10 minutes), it publishes one post per move: the signal card beside SPY's 1-minute chart, and a caption with the move and the headline. Never advice; a record of what the engine called and what SPY did."
