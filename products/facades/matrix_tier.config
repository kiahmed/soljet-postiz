# === Facades · Matrix — product tier config ===
# File-per-product layout: products/facades/<name>_tier.config, registered in
# src/lib/config_loader.py::_TIER_FILE_BY_ID. Shell-style key="value", same
# parser as arboryx.ai/tier.config. tier.dir is products/facades/.
#
# See docs/matrix_integration.md for the full spec (event catalog, screenshot
# design, gating philosophy) and EdgeLane's docs/matrix_events_update.md for
# the upstream engine contract this config assumes.

TIER_ID="matrix"
TIER_NAME="Matrix"
TIER_PARENT=""                              # standalone product, not a branch
CONTEXT_FILE="matrix_context.md"

# === Live data source ============================================
# Event-driven, same mold as Simmer, but its OWN Pub/Sub topic — Matrix does
# NOT share facades.ticker-events. The matrix_api source is the on-demand read
# side: the poster re-pulls a symbol's current pick/bias/grid state by block.
DATA_SOURCE_1_TYPE="matrix_api"
DATA_SOURCE_1_BASE_URL="${MATRIX_API_BASE}"          # e.g. https://edge.facades.trade
DATA_SOURCE_1_TOKEN_ENV="MATRIX_API_TOKEN"           # bearer, service token (not a user JWT)
DATA_SOURCE_1_STATE_PATH="/matrix/state"             # GET /<SYMBOL>?block=pick|grid|bias|win_eval|walls

# Pub/Sub wiring for bin/matrix_poster.py (the Cloud Run subscriber).
MATRIX_PUBSUB_PROJECT="${GCP_PROJECT}"
MATRIX_PUBSUB_TOPIC="${MATRIX_EVENTS_TOPIC}"                 # facades.matrix-events, a topic of its own (not shared with Simmer)
MATRIX_PUBSUB_SUBSCRIPTION="${MATRIX_PUBSUB_SUBSCRIPTION}"   # e.g. matrix-poster-sub
# Which engine states publish a post — see docs/matrix_integration.md §Post
# moments. All 6 moments (7 states — bias splits into 2) are live as of
# 2026-09-13: EdgeLane ships all 5 snap views + all state blocks, and the
# engine itself is the primary "is this worth posting" gate (POST_ON_STATES
# just says which states we're willing to publish at all).
POST_ON_STATES="pick_selected,bias_aligned,bias_diverged,win_rate_notable,session_open,grid_digest,daily_recap"

# Per-state min-gap safety net (docs/matrix_integration.md §Gating) — NOT the
# primary gate, insurance against a bug in the engine's own significance
# logic turning into a wall of posts. Reactive states (pick_selected,
# bias_aligned/diverged, win_rate_notable) have no floor — they already only
# fire on a real transition. Cadence-flavored ones get one:
MATRIX_MIN_GAP_HOURS_SESSION_OPEN="20"      # at most ~1/day
MATRIX_MIN_GAP_HOURS_GRID_DIGEST="60"       # target ~2x/week (matches EdgeLane own cooldown)
MATRIX_MIN_GAP_HOURS_DAILY_RECAP="20"       # at most ~1/day

# Market-hours gate (src/lib/market_hours.py): 9:30-16:00 ET, Mon-Fri only, no
# exception (unlike Simmer's off_hours_catalyst allowance — a multi-leg spread
# read against a stale chain has no equivalent fallback story). "false"
# disables the gate entirely (testing only).
MARKET_HOURS_ENFORCED="true"

# === Channels (Postiz integration IDs) ==========================
# Both connected under Postiz Customer "Facades" (same customer as Simmer),
# same LinkedIn/X apps as every other Facades product.
#   LinkedIn "Matrix" page.
CHANNEL_LINKEDIN="${POSTIZ_INTEGRATION_ID_LINKEDIN_MATRIX}"
#   X @facades_matrix.
CHANNEL_X_PRIMARY="${POSTIZ_INTEGRATION_ID_X_MATRIX}"

# === Postiz routing ============================================
POSTIZ_CUSTOMER_ID="${POSTIZ_CUSTOMER_ID_MATRIX}"    # same "Facades" customer as Simmer

# === Imagery ==================================================
# Both channels attach the auto-snapped crop (see CARD_RENDER_PROVIDER).
IMAGERY_POLICY_X="attach"
IMAGERY_POLICY_LINKEDIN="attach"
# Per-product Cloud Run screenshot service: POST {symbol,expiry,state,view} ->
# PNG crop of the named Matrix view (engine_pick/strategy_grid/bias_chip/
# walls_chip/win_eval_grid). src/lib/card_images.py routes tier `matrix` here.
CARD_RENDER_PROVIDER="matrix_snap"
MATRIX_SNAP_URL="${MATRIX_SNAP_URL}"

# === Tagging (see linkedin-mentions.md) =======================
# OFF, same lesson as Simmer's double-cashtag bug: compose_matrix() already
# writes exactly one "$SYM" into the body. Letting the dispatcher append an
# entity cashtag too would produce a second one, which X rejects ("maximum of
# one cashtag per post").
HANDLE_INJECTION="false"
CASHTAGS_ENABLED="false"
ENTITY_TAG_MODE="cashtag_only"
MAX_ENTITY_TAGS="0"
POST_TEXT_SOURCE="share"

# === Deep-link funnel ========================================
PARENT_URL_TEMPLATE="https://matrix.facades.trade/?symbol={symbol}"
LET_PLATFORM_RENDER_LINK_CARD="false"       # we always attach our own crop

# === Cadence hints ===========================================
POSTING_CADENCE_DAILY="false"               # event-driven, not a daily drain
POSTING_TIMEZONE="America/New_York"

# === Posting purpose ========================================
POSTING_PURPOSE="Matrix is an options strategy-grid engine: for a watched ticker it scores and ranks 8 candidate spread structures (bull put, bear call, iron condor, iron fly, bull call, bear put, call fly, put fly), picks the best one, and tracks whether that pick is actually winning. Posts announce the moments worth sharing — a new engine pick, a bias read that agrees or disagrees with it, a win-rate pattern earned over time, the day's walls, a periodic full-grid digest, and a once-daily plain-language read on the best/worst setup — never a blind cadence. Never advice; a snapshot of engine state at post time."
