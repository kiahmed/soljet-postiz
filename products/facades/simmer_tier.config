# === Facades · Simmer — product tier config ===
# File-per-product layout: products/facades/<name>_tier.config, registered in
# src/lib/config_loader.py::_TIER_FILE_BY_ID. Shell-style key="value", same
# parser as arboryx.ai/tier.config. tier.dir is products/facades/.

TIER_ID="simmer"
TIER_NAME="Simmer"
TIER_PARENT=""                              # standalone product, not a branch
CONTEXT_FILE="simmer_context.md"

# === Live data source ============================================
# Event-driven: the Simmer engine publishes ticker state-change events to a
# GCP Pub/Sub topic (per-product subscription filter attributes.product="simmer").
# The `simmer_api` source is the on-demand read side — the poster re-pulls a
# ticker's current state / full card by block from EdgeLane's read-only API.
DATA_SOURCE_1_TYPE="simmer_api"
DATA_SOURCE_1_BASE_URL="${SIMMER_API_BASE}"          # e.g. https://edge.facades.trade
DATA_SOURCE_1_TOKEN_ENV="SIMMER_API_TOKEN"           # bearer, service token (not a user JWT)
DATA_SOURCE_1_READY_PATH="/simmer/ready"             # GET ?since=YYYY-MM-DD -> ready tickers
DATA_SOURCE_1_STATE_PATH="/simmer/state"            # GET /<SYMBOL>?block=card|score|gates|sentiment|evolution

# Pub/Sub wiring for bin/simmer_poster.py (the Cloud Run subscriber).
SIMMER_PUBSUB_PROJECT="${GCP_PROJECT}"
SIMMER_PUBSUB_SUBSCRIPTION="${SIMMER_PUBSUB_SUBSCRIPTION}"   # e.g. simmer-poster-sub
# Which engine states publish a post. watch_entered = "started simmering",
# ready = "ready to serve" (the old alert). Others (score_crossed, dropped,
# expiry_near) off until we decide.
POST_ON_STATES="watch_entered,ready"

# === Channels (Postiz integration IDs) ==========================
# Both connected under Postiz Customer "Facades", same LinkedIn/X apps as every
# other Facades product. Ids live in .env; see products/facades/simmer_handles.yaml
# for the human-readable mirror.
#   LinkedIn Simmer page — connected 2026-09-07 (CM-API dev app).
CHANNEL_LINKEDIN="${POSTIZ_INTEGRATION_ID_LINKEDIN_SIMMER}"
#   X @facades_simmer — connected 2026-09-10.
CHANNEL_X_PRIMARY="${POSTIZ_INTEGRATION_ID_X_SIMMER}"

# === Postiz routing ============================================
POSTIZ_CUSTOMER_ID="${POSTIZ_CUSTOMER_ID_SIMMER}"    # Customer "Facades"

# === Imagery ==================================================
# Both channels attach the auto-snapped board crop (see CARD_RENDER_PROVIDER).
IMAGERY_POLICY_X="attach"
IMAGERY_POLICY_LINKEDIN="attach"
# Per-product Cloud Run screenshot service: POST {symbol,expiry} -> PNG crop of
# the Simmer board ([data-snap="card"]: GEX walls + gates + readiness + news
# score). src/lib/card_images.py routes tier `simmer` here instead of GCS.
CARD_RENDER_PROVIDER="simmer_snap"
SIMMER_SNAP_URL="${SIMMER_SNAP_URL}"

# === Tagging (see linkedin-mentions.md) =======================
HANDLE_INJECTION="true"
ENTITY_TAG_MODE="prefer_handle"
MAX_ENTITY_TAGS="1"                          # one $TICKER / @handle per post
CASHTAGS_ENABLED="true"                      # $MSTR etc — public tickers only
POST_TEXT_SOURCE="share"

# === Deep-link funnel ========================================
# Every post links to the ticker's live Simmer board. The auto-snapped image
# is the click target on X's/LinkedIn's card; the URL carries the funnel.
PARENT_URL_TEMPLATE="https://simmer.facades.trade/?symbol={symbol}"
LET_PLATFORM_RENDER_LINK_CARD="false"       # we always attach our own crop

# === Cadence hints ===========================================
POSTING_CADENCE_DAILY="false"               # event-driven, not a daily drain
POSTING_TIMEZONE="America/New_York"

# === Posting purpose ========================================
POSTING_PURPOSE="Simmer is a credit-spread income watchdog: it tracks AI-bottleneck and high-IV tickers, scores when premium is overpriced relative to where price is unlikely to go, and calls the ones ready to be served. Posts announce two moments — a ticker entering the watch (started simmering) and a ticker turning ready (ready to serve) — with the board snapshot (GEX walls, gate checklist, readiness + news-sentiment score) and a deep link to its live Simmer page. Never advice; a snapshot of engine state at post time."
